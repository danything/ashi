{
  "name": "ashi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIに、足を。 Give your AI legs.",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build && bun build src/cli.ts --target=bun --outfile=build/cli.js && bun build src/mcp.ts --target=bun --outfile=build/mcp.js",
    "start": "bun ./build",
    "ashi": "bun src/cli.ts",
    "test": "bun test tests",
    "lint": "oxlint && bun fmt --check",
    "format": "oxlint --fix && bun fmt",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --fail-on-warnings"
  },
  "devDependencies": {
    "3d-force-graph": "^1.80.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "@picocss/pico": "^2.1.1",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7",
    "hucre": "^1.3.0",
    "marked": "^18.1.2",
    "oxlint": "^1.90.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "unpdf": "^2.0.1",
    "vite": "^8.3.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
