{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"types": ["bun", "$app/types"],
		// #lib は package.json の imports で解決される。同じものを paths にも書くのは svelte-check --tsgo のため:
		// imports 経由だと .svelte の型(svelte2tsx の出力)に届かず、props も型も検査されなくなる
		"paths": { "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "tests", "vite.config.ts"]
}
